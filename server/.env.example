# Copy this file to ".env" and fill in the values. Never commit ".env".

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put the database name ("portfolio") before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Frontend URLs allowed to call this API. Comma-separated, no trailing slash.
# Production example: https://your-site.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Contact form rate limit: RATE_LIMIT_MAX messages per RATE_LIMIT_WINDOW_MINUTES per IP.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# Optional: Telegram alert when someone sends a message (free, official).
# See README section "Phone alerts". Leave both empty to switch it off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: WhatsApp alert when someone sends a message (free CallMeBot service).
# Leave both empty to switch alerts off. See README section "WhatsApp alerts".
# Phone: country code + number, digits only. Example for India: 919876543210
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Number of proxies in front of the server (1 on Render). Leave empty locally.
TRUST_PROXY=
