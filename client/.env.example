# Copy this file to ".env" for local work. On Vercel, add these in Project Settings > Environment Variables.

# URL of the backend API (no trailing slash).
# Leave empty in local development: Vite forwards /api to http://localhost:5000.
# Production example: https://bharadwaz-portfolio-api.onrender.com
VITE_API_URL=

# Public URL of this website (no trailing slash). Used for link previews (Open Graph).
# Example: https://bharadwaz.vercel.app
VITE_SITE_URL=

# Optional: only for local development if your API runs on another port.
# VITE_DEV_API_TARGET=http://localhost:5000
